# Copy to .env and fill in. .env is git-ignored; never commit credentials.
#
# Everything here is optional: with no .env at all, the demo application and the
# integration suite run against SK's free test services with the credentials SK
# publishes.

# demo | live
#
# "demo" uses the free test services. Nothing it produces is a valid signature.
#
# "live" uses the real services with the credentials below. Every signature is a
# real signature by a real person, requests go to real phones, and timestamps
# are billed. Live mode refuses to start unless all five values are present; it
# will not fall back to the test services, because a signature made against
# those looks valid and is worth nothing.
ALLKIRI_MODE=demo

# From your SK contracts. The identifiers are shared secrets, not names.
ALLKIRI_MID_RP_UUID=
ALLKIRI_MID_RP_NAME=
ALLKIRI_SMARTID_RP_UUID=
ALLKIRI_SMARTID_RP_NAME=

# Optional, live mode only: a sentence shown on the phone above the verification
# code. Mobile-ID shows your relying-party name anyway, and refuses characters
# GSM-7 cannot carry, so leaving this empty is usually right.
ALLKIRI_MID_DISPLAY_TEXT=

# Exactly what the browser reports as location.origin, scheme and port included.
# The ID card signs this string, so a mismatch verifies nothing. Required in live
# mode; the demo assumes https://localhost:8443.
ALLKIRI_ORIGIN=

# Run the tests that talk to the demo services. Takes a couple of minutes.
ALLKIRI_INTEGRATION=0

# Run the one-shot live smoke test: one Mobile-ID and one Smart-ID signature
# against the real services, validated in SiVa production. Needs ALLKIRI_MODE=live
# and a real phone in your hand. Nothing scheduled ever sets this.
ALLKIRI_LIVE_SMOKE=0

# The phone number and identity codes the live smoke test signs with. Yours.
ALLKIRI_LIVE_MID_PHONE=
ALLKIRI_LIVE_MID_CODE=
ALLKIRI_LIVE_SMARTID_CODE=

# Logging. Three switches, because they are three different decisions.
#
# ALLKIRI_LOG is a file path; empty means no logging at all. The demo writes one
# JSON object per line there: the audit trail, plus the library's own milestones.
#
# ALLKIRI_LOG_HTTP=1 adds every remote call the library makes, which is a
# transcript rather than a record.
#
# ALLKIRI_LOG_PERSONAL_DATA=1 lets that transcript carry request and response
# bodies and whole URLs, which means identity codes, phone numbers and
# certificates. Debugging only, with a retention period. Credentials are never
# logged whatever this says. See docs/logging.md.
ALLKIRI_LOG=
ALLKIRI_LOG_HTTP=0
ALLKIRI_LOG_PERSONAL_DATA=0

# Where to write the containers a test produces, for opening in DigiDoc4.
ALLKIRI_ARTEFACTS=

# Only needed where PHP has no curl.cainfo configured, which is common on
# Windows and makes every HTTPS call fail with curl error 60.
ALLKIRI_CA_BUNDLE=

# Override a service endpoint. Rarely useful; the mode picks these.
ALLKIRI_MID_URL=
ALLKIRI_SMARTID_URL=
