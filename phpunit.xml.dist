<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
         failOnDeprecation="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerWarnings="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <!-- Talks to the SK / RIA / Zetes demo environments. Self-skips unless ALLKIRI_INTEGRATION=1. -->
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
        <!--
            Signs for real, against the production services, with a real phone.
            Its own suite so that nothing else ever loads it; self-skips unless
            ALLKIRI_LIVE_SMOKE=1 and ALLKIRI_MODE=live. See docs/releasing.md.
        -->
        <testsuite name="LiveSmoke">
            <directory>tests/LiveSmoke</directory>
        </testsuite>
    </testsuites>
    <!--
        A deprecation that src raises, or that a dependency raises because of
        what src asked of it, fails a run. One a dependency raises within itself,
        at the oldest version a constraint allows, is that dependency's to fix.
    -->
    <source ignoreIndirectDeprecations="true">
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
