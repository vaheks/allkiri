# Store text as LF so CI (Linux) and Windows checkouts agree.
* text=auto eol=lf

# Signed containers and DER blobs must never be touched.
*.asice binary
*.bdoc binary
*.sce binary
*.ddoc binary
*.zip binary
*.der binary
*.p12 binary
*.pfx binary
*.tsr binary
*.ors binary
*.png binary

# A third-party file the demo pins by its hash: stored and checked out byte for
# byte, whatever the line-ending rules above become.
/examples/demo-app/public/vendor/web-eid.js -text

# Kept out of the Packagist archive: the test suite carries megabytes of
# containers and PKI fixtures that no consumer needs, and the demo is a whole
# web application, front controller included, that nobody installing a library
# is meant to run. It is read from a clone, which is how every command in its
# README is written. assets/ and resources/ stay: the browser helpers are files
# an application serves, and the trust anchors are required at runtime. docs/
# stays because composer.json points support.docs at it.
/tests export-ignore
/examples export-ignore
/.github export-ignore
/phpunit.xml.dist export-ignore
/phpstan.neon.dist export-ignore
/.php-cs-fixer.dist.php export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.editorconfig export-ignore
/CONTRIBUTING.md export-ignore
